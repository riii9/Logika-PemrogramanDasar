<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="week 5 no 1"/>
        <attribute name="authors" value="M S I"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-07 10:25:16 AM"/>
        <attribute name="created" value="TSBTIEk7TVNJOzIwMjYtMDktMDc7MTA6MjE6NDEgQU07MTc5NA=="/>
        <attribute name="edited" value="TSBTIEk7TVNJOzIwMjYtMDktMDc7MTA6MjU6MTYgQU07MTsxOTA4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, n, digit" type="Integer" array="False" size=""/>
            <assign variable="digit" expression="0"/>
            <input variable="n"/>
            <while expression="n&gt;0">
                <assign variable="n" expression="n/10"/>
                <assign variable="digit" expression="digit+1"/>
            </while>
            <output expression="digit" newline="True"/>
        </body>
    </function>
</flowgorithm>
