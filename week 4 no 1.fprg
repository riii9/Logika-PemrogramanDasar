<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="week 4 no 1"/>
        <attribute name="authors" value="M S I"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-31 01:15:36 PM"/>
        <attribute name="created" value="TSBTIEk7TVNJOzIwMjYtMDgtMzE7MDE6MDM6MTEgUE07MTgwMg=="/>
        <attribute name="edited" value="TSBTIEk7TVNJOzIwMjYtMDgtMzE7MDE6MTU6MzYgUE07MTsxOTIw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, i, b" type="Integer" array="False" size=""/>
            <output expression="&quot;masukan nilai n: &quot;" newline="True"/>
            <input variable="n"/>
            <assign variable="b" expression="n/3"/>
            <for variable="i" start="1" end="b" direction="inc" step="1">
                <if expression="i*3&lt;=n">
                    <then>
                        <output expression="i * 3 &amp;&quot; &quot;" newline="False"/>
                    </then>
                    <else/>
                </if>
            </for>
        </body>
    </function>
</flowgorithm>
