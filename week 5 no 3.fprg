<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="week 5 no 3"/>
        <attribute name="authors" value="M S I"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-07 02:23:49 PM"/>
        <attribute name="created" value="TSBTIEk7TVNJOzIwMjYtMDktMDc7MDE6NTc6MDQgUE07MTgxNw=="/>
        <attribute name="edited" value="TSBTIEk7TVNJOzIwMjYtMDktMDc7MDI6MjM6NDkgUE07MTsxOTI4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, j, n" type="Integer" array="False" size=""/>
            <output expression="&quot;masukan n bilangan bulat genap positif&quot;" newline="True"/>
            <input variable="n"/>
            <declare name="arr" type="Integer" array="True" size="n"/>
            <declare name="space" type="String" array="False" size=""/>
            <assign variable="space" expression="&quot; &quot;"/>
            <for variable="i" start="0" end="n-1" direction="inc" step="1">
                <output expression="&quot;masukan elemen array ke - &quot; &amp;i+1" newline="True"/>
                <input variable="arr[i]"/>
            </for>
            <output expression="&quot;----for----&quot;" newline="True"/>
            <for variable="i" start="0" end="n/2-1" direction="inc" step="1">
                <for variable="j" start="0" end="1" direction="inc" step="1">
                    <output expression="arr[(i*2)+j]&amp; space" newline="False"/>
                    <assign variable="space" expression="space&amp;&quot; &quot;"/>
                </for>
                <output expression="&quot; &quot;" newline="True"/>
            </for>
            <assign variable="i" expression="0"/>
            <assign variable="space" expression="&quot;  &quot;"/>
            <output expression="&quot;----while----&quot;" newline="True"/>
            <while expression="i&lt;n">
                <output expression="arr[i] &amp; space &amp; arr[i+1]&amp;space" newline="False"/>
                <output expression="&quot;&quot;" newline="True"/>
                <assign variable="space" expression="space&amp;&quot;  &quot;"/>
                <assign variable="i" expression="i+2"/>
            </while>
        </body>
    </function>
</flowgorithm>
