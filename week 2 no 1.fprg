    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="array" type="Integer" array="True" size="4"/>
            <output expression="&quot;masukan nilai ke-1 &quot;" newline="True"/>
            <input variable="array[0]"/>
            <output expression="&quot;masukan nilai ke-2 &quot;" newline="True"/>
            <input variable="array[1]"/>
            <output expression="&quot;masukan nilai ke-3 &quot;" newline="True"/>
            <input variable="array[2]"/>
            <output expression="&quot;masukan nilai ke-4 &quot;" newline="True"/>
            <input variable="array[3]"/>
            <output expression="&quot;nilai sebelum ditukar &quot;&amp; &quot;[&quot;&amp;array[0]&amp;&quot;,&quot;&amp; array[1]&amp;&quot;,&quot;&amp;array[2]&amp;&quot;,&quot;&amp;array[3]&amp;&quot;]&quot;" newline="True"/>
            <declare name="NilaiTemp" type="Integer" array="False" size=""/>
            <assign variable="NilaiTemp" expression="array[0]"/>
            <assign variable="array[0]" expression="array[3]"/>
            <assign variable="array[3]" expression="NilaiTemp"/>
            <output expression="&quot;nilai sesudah ditukar &quot;&amp; &quot;[&quot;&amp;array[0]&amp;&quot;,&quot;&amp; array[1]&amp;&quot;,&quot;&amp;array[2]&amp;&quot;,&quot;&amp;array[3]&amp;&quot;]&quot;" newline="True"/>
        </body>
    </function>
