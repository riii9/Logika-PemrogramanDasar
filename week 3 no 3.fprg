<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="week 3 no 3"/>
        <attribute name="authors" value="M S I"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-24 01:15:54 PM"/>
        <attribute name="created" value="TSBTIEk7TVNJOzIwMjYtMDgtMjQ7MTA6MjI6NTggQU07MTgwMQ=="/>
        <attribute name="edited" value="TSBTIEk7TVNJOzIwMjYtMDgtMjQ7MDE6MTU6NTQgUE07MjsxOTIz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="etape1, etape2, etape3, total" type="Integer" array="False" size=""/>
            <output expression="&quot;masukan etape 1&quot;" newline="True"/>
            <input variable="etape1"/>
            <output expression="&quot;masukan etape 2&quot;" newline="True"/>
            <input variable="etape2"/>
            <output expression="&quot;masukan etape 3&quot;" newline="True"/>
            <input variable="etape3"/>
            <assign variable="total" expression="0"/>
            <if expression="etape1&lt;=10">
                <then>
                    <assign variable="total" expression="total+100-((etape1-1)*5)"/>
                </then>
                <else>
                    <assign variable="total" expression="total+50"/>
                </else>
            </if>
            <if expression="etape2&lt;=10">
                <then>
                    <assign variable="total" expression="total+100-((etape2-1)*5)"/>
                </then>
                <else>
                    <assign variable="total" expression="total+50"/>
                </else>
            </if>
            <if expression="etape3&lt;=10">
                <then>
                    <assign variable="total" expression="total+100-((etape3-1)*5)"/>
                </then>
                <else>
                    <assign variable="total" expression="total+50"/>
                </else>
            </if>
            <output expression="&quot;Nilai total seorang peserta adalah &quot;&amp;total" newline="True"/>
        </body>
    </function>
</flowgorithm>
