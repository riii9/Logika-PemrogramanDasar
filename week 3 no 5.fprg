    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="bil" type="Integer" array="False" size=""/>
            <output expression="&quot;masukan bilangan yg akan dicek&quot;" newline="True"/>
            <input variable="bil"/>
            <if expression="bil%3==0&amp;&amp;bil%4==0">
                <then>
                    <output expression="&quot;bilangan &quot;&amp;bil&amp; &quot; habis dibagi 3 dan habis dibagi 4&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="bil%3==0&amp;&amp;bil%4!=0">
                        <then>
                            <output expression="&quot;bilangan &quot;&amp;bil&amp; &quot; habis dibagi 3 dan tidak habis dibagi 4&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;bilangan &quot;&amp;bil&amp; &quot; tidak habis dibagi 3 dan tidak habis dibagi 4&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
