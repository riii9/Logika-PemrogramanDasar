<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="week 4 no 3"/>
        <attribute name="authors" value="M S I"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-31 01:36:11 PM"/>
        <attribute name="created" value="TSBTIEk7TVNJOzIwMjYtMDgtMzE7MDE6MjA6NDcgUE07MTgxMA=="/>
        <attribute name="edited" value="TSBTIEk7TVNJOzIwMjYtMDgtMzE7MDE6MzY6MTEgUE07MTsxOTE2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, i, total" type="Integer" array="False" size=""/>
            <declare name="mean" type="Real" array="False" size=""/>
            <assign variable="total" expression="0"/>
            <output expression="&quot;masukan nilai n&quot;" newline="True"/>
            <input variable="n"/>
            <for variable="i" start="1" end="n" direction="inc" step="1">
                <assign variable="total" expression="total+random(n)"/>
            </for>
            <assign variable="mean" expression="total/n"/>
            <output expression="mean" newline="True"/>
        </body>
    </function>
</flowgorithm>
