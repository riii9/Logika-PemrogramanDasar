<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="week 3 no 2"/>
        <attribute name="authors" value="M S I"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-24 05:26:00 PM"/>
        <attribute name="created" value="TSBTIEk7TVNJOzIwMjYtMDgtMjQ7MTA6MTg6NTIgQU07MTgwMA=="/>
        <attribute name="edited" value="TSBTIEk7TVNJOzIwMjYtMDgtMjQ7MDU6MjY6MDAgUE07MjsxOTIw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="tinggi" type="Integer" array="False" size=""/>
            <output expression="&quot;masukan tinggi&quot;" newline="True"/>
            <input variable="tinggi"/>
            <if expression="tinggi&gt;=120&amp;&amp;tinggi&lt;=150">
                <then>
                    <output expression="&quot;tinggi badan &quot; &amp;tinggi&amp;&quot; cm termasuk kelompok sedang&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="tinggi&gt;150">
                        <then>
                            <output expression="&quot;tinggi badan &quot; &amp;tinggi&amp;&quot; cm termasuk kelompok tinggi&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;tinggi badan &quot; &amp;tinggi&amp;&quot; cm termasuk kelompok pendek&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
